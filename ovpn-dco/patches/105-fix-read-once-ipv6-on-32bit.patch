 }
 
+/* READ_ONCE() cannot access 16-byte in6_addr on 32-bit arches */
+static inline struct in6_addr ovpn_bind_read_local_ipv6(const struct ovpn_bind *bind)
+{
+	struct in6_addr addr;
+
+	addr.s6_addr32[0] = READ_ONCE(bind->local.ipv6.s6_addr32[0]);
+	addr.s6_addr32[1] = READ_ONCE(bind->local.ipv6.s6_addr32[1]);
+	addr.s6_addr32[2] = READ_ONCE(bind->local.ipv6.s6_addr32[2]);
+	addr.s6_addr32[3] = READ_ONCE(bind->local.ipv6.s6_addr32[3]);
+	return addr;
+}
