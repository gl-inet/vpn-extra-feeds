 drivers/net/ovpn/io.h   |   3 +
 drivers/net/ovpn/peer.c |  62 ++++++++-
 drivers/net/ovpn/peer.h |  19 +++
 drivers/net/ovpn/skb.h  |   2 +
 5 files changed, 269 insertions(+), 90 deletions(-)

