+
+/* New N-work pool decrypt post callback - simplified, direct delivery */
+void ovpn_decrypt_post(void *data, int ret)
+{
+	struct ovpn_crypto_key_slot *ks;
+	unsigned int payload_offset = 0;
+	struct sk_buff *skb = data;
+	struct ovpn_socket *sock;
+	struct ovpn_peer *peer;
+	__be32 *pid;
+
+	/* crypto is happening asynchronously. this function will be called
+	 * again later by the crypto callback with a proper return code
+	 */
+	if (unlikely(ret == -EINPROGRESS))
+		return;
+
+	payload_offset = ovpn_skb_cb(skb)->payload_offset;
+	ks = ovpn_skb_cb(skb)->ks;
+	peer = ovpn_skb_cb(skb)->peer;
+
+	/* crypto is done, cleanup skb CB and its members */
+	kmem_cache_free(ovpn_crypto_tmp_cache, ovpn_skb_cb(skb)->crypto_tmp);
+
+	if (unlikely(ret < 0))
+		goto drop;
+
+	/* PID sits after the op */
+	pid = (__force __be32 *)(skb->data + OVPN_OPCODE_SIZE);
+	ret = ovpn_pktid_recv(&ks->pid_recv, ntohl(*pid), 0);
+	if (unlikely(ret < 0)) {
+		net_err_ratelimited("%s: PKT ID RX error for peer %u: %d\n",
+				    netdev_name(peer->ovpn->dev), peer->id, ret);
+		goto drop;
+	}
+
+	/* keep track of last received authenticated packet for keepalive */
+	{
+		time64_t now = ktime_get_real_seconds();
+
+		if (unlikely(now != READ_ONCE(peer->last_recv)))
+			WRITE_ONCE(peer->last_recv, now);
+	}
+
+	rcu_read_lock();
+	sock = rcu_dereference(peer->sock);
+	if (sock && sock->sk->sk_protocol == IPPROTO_UDP)
+		ovpn_peer_endpoints_update(peer, skb);
+	rcu_read_unlock();
+
+	/* point to encapsulated IP packet */
+	__skb_pull(skb, payload_offset);
+
+	/* deliver the decrypted packet - ordering for TCP tunneled traffic
+	 * is handled by the upper layer TCP stack, not here
+	 */
+	ovpn_deliver_skb(peer, skb);
+	/* skb is passed to upper layer - don't free it */
 	skb = NULL;
 drop:
 	if (unlikely(skb))
 		dev_dstats_rx_dropped(peer->ovpn->dev);
 	kfree_skb(skb);
-drop_nocount:
 	if (likely(peer))
 		ovpn_peer_put(peer);
 	if (likely(ks))
 		ovpn_crypto_key_slot_put(ks);
 }
 
-/* RX path entry point: decrypt packet and forward it to the device */
-void ovpn_recv(struct ovpn_peer *peer, struct sk_buff *skb)
+/* N-work pool decrypt worker - dequeues skbs and decrypts them */
+void ovpn_decrypt_worker(struct work_struct *work)
 {
+	struct ovpn_decrypt_ctx *ctx = container_of(work, struct ovpn_decrypt_ctx, work);
+	struct ovpn_peer *peer = ctx->peer;
 	struct ovpn_crypto_key_slot *ks;
+	struct sk_buff *skb;
+	unsigned int drop_refs = 0;
 	u8 key_id;
 
-	ovpn_peer_stats_increment_rx(&peer->link_stats, skb->len);
+	while ((skb = skb_dequeue(&peer->decrypt_queue)) != NULL) {
+		key_id = ovpn_key_id_from_skb(skb);
+		ks = ovpn_crypto_key_id_to_slot(&peer->crypto, key_id);
+		if (unlikely(!ks)) {
+			net_info_ratelimited("%s: no key found for key_id %u for peer %u\n",
+					    netdev_name(peer->ovpn->dev), key_id,
+					    peer->id);
+			dev_dstats_rx_dropped(peer->ovpn->dev);
+			kfree_skb(skb);
+			/* Defer peer_put to avoid triggering peer release
+			 * (which calls cancel_work_sync) from within this worker
+			 */
+			drop_refs++;
+			continue;
+		}
 
-	/* get the key slot matching the key ID in the received packet */
-	key_id = ovpn_key_id_from_skb(skb);
-	ks = ovpn_crypto_key_id_to_slot(&peer->crypto, key_id);
-	if (unlikely(!ks)) {
-		net_info_ratelimited("%s: no available key for peer %u, key-id: %u\n",
-				     netdev_name(peer->ovpn->dev), peer->id,
-				     key_id);
-		dev_dstats_rx_dropped(peer->ovpn->dev);
-		kfree_skb(skb);
-		ovpn_peer_put(peer);
-		return;
+		memset(ovpn_skb_cb(skb), 0, sizeof(struct ovpn_cb));
+		ovpn_decrypt_post(skb, ovpn_aead_decrypt(peer, ks, skb));
 	}
 
-	memset(ovpn_skb_cb(skb), 0, sizeof(struct ovpn_cb));
-	ovpn_decrypt_post(skb, ovpn_aead_decrypt(peer, ks, skb));
+	/* Release deferred peer references after the loop completes,
+	 * so cancel_work_sync in peer_release won't deadlock
+	 */
+	while (drop_refs--)
+		ovpn_peer_put(peer);
+}
+
+/* RX path entry point: enqueue skb and schedule decrypt worker */
+void ovpn_recv(struct ovpn_peer *peer, struct sk_buff *skb)
+{
+	int idx;
+
+	ovpn_peer_stats_increment_rx(&peer->link_stats, skb->len);
+
+	/* Enqueue skb to peer's decrypt queue */
+	skb_queue_tail(&peer->decrypt_queue, skb);
+
+	/* Round-robin select a work context and queue it */
+	idx = atomic_inc_return(&peer->next_decrypt_idx) % OVPN_MAX_PARALLEL;
+	queue_work(ovpn_crypto_wq, &peer->decrypt_ctx[idx].work);
 }
 
