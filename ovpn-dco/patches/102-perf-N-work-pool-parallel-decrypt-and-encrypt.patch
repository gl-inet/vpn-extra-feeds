 }
 
-static bool ovpn_encrypt_one(struct ovpn_peer *peer, struct sk_buff *skb)
+/* TX N-work pool encrypt worker */
+void ovpn_encrypt_worker(struct work_struct *work)
 {
+	struct ovpn_encrypt_ctx *ctx = container_of(work, struct ovpn_encrypt_ctx, work);
+	struct ovpn_peer *peer = ctx->peer;
 	struct ovpn_crypto_key_slot *ks;
+	struct sk_buff *skb;
+	unsigned int drop_refs = 0;
+
+	while ((skb = skb_dequeue(&peer->encrypt_queue)) != NULL) {
+		ks = ovpn_crypto_key_slot_primary(&peer->crypto);
+		if (unlikely(!ks)) {
+			dev_dstats_tx_dropped(peer->ovpn->dev);
+			kfree_skb(skb);
+			drop_refs++;
+			continue;
+		}
 
-	/* get primary key to be used for encrypting data */
-	ks = ovpn_crypto_key_slot_primary(&peer->crypto);
-	if (unlikely(!ks))
-		return false;
-
-	/* take a reference to the peer because the crypto code may run async.
-	 * ovpn_encrypt_post() will release it upon completion
-	 */
-	if (unlikely(!ovpn_peer_hold(peer))) {
-		DEBUG_NET_WARN_ON_ONCE(1);
-		ovpn_crypto_key_slot_put(ks);
-		return false;
+		memset(ovpn_skb_cb(skb), 0, sizeof(struct ovpn_cb));
+		ovpn_encrypt_post(skb, ovpn_aead_encrypt(peer, ks, skb));
 	}
 
-	memset(ovpn_skb_cb(skb), 0, sizeof(struct ovpn_cb));
-	ovpn_encrypt_post(skb, ovpn_aead_encrypt(peer, ks, skb));
-	return true;
+	while (drop_refs--)
+		ovpn_peer_put(peer);
 }
 
 /* send skb to connected peer, if any */
 static void ovpn_send(struct ovpn_priv *ovpn, struct sk_buff *skb,
 		      struct ovpn_peer *peer)
 {
+	struct ovpn_crypto_key_slot *ks;
+	struct ovpn_socket *sock;
 	struct sk_buff *curr, *next;
+	bool use_wq;
+	int idx;
 
-	/* this might be a GSO-segmented skb list: process each skb
-	 * independently
+	/* TCP transport cannot use workqueue for encryption because
+	 * ovpn_tcp_send_skb requires socket lock which has ordering
+	 * constraints with strparser's softirq context.
 	 */
+	rcu_read_lock();
+	sock = rcu_dereference(peer->sock);
+	use_wq = sock && sock->sk->sk_protocol == IPPROTO_UDP;
+	rcu_read_unlock();
+
 	skb_list_walk_safe(skb, curr, next) {
-		if (unlikely(!ovpn_encrypt_one(peer, curr))) {
-			dev_dstats_tx_dropped(ovpn->dev);
-			kfree_skb(curr);
+		skb_mark_not_on_list(curr);
+
+		if (use_wq) {
+			/* UDP: parallel encryption via workqueue */
+			if (unlikely(!ovpn_peer_hold(peer))) {
+				dev_dstats_tx_dropped(ovpn->dev);
+				kfree_skb(curr);
+				continue;
+			}
+
+			skb_queue_tail(&peer->encrypt_queue, curr);
+			idx = atomic_inc_return(&peer->next_encrypt_idx) % OVPN_MAX_PARALLEL;
+			queue_work(ovpn_crypto_wq, &peer->encrypt_ctx[idx].work);
+		} else {
+			/* TCP: synchronous encryption */
+			ks = ovpn_crypto_key_slot_primary(&peer->crypto);
+			if (unlikely(!ks)) {
+				dev_dstats_tx_dropped(ovpn->dev);
+				kfree_skb(curr);
+				continue;
+			}
+
+			if (unlikely(!ovpn_peer_hold(peer))) {
+				ovpn_crypto_key_slot_put(ks);
+				dev_dstats_tx_dropped(ovpn->dev);
+				kfree_skb(curr);
+				continue;
+			}
+
+			memset(ovpn_skb_cb(curr), 0, sizeof(struct ovpn_cb));
+			ovpn_encrypt_post(curr, ovpn_aead_encrypt(peer, ks, curr));
 		}
 	}
 
