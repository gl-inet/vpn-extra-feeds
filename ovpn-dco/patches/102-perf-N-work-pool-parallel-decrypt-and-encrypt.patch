 	ovpn_crypto_state_init(&peer->crypto);
 	spin_lock_init(&peer->lock);
 	kref_init(&peer->refcount);
-	ovpn_peer_stats_init(&peer->vpn_stats);
-	ovpn_peer_stats_init(&peer->link_stats);
+
+	ret = ovpn_peer_stats_init(&peer->vpn_stats);
+	if (ret < 0)
+		goto err_free;
+
+	ret = ovpn_peer_stats_init(&peer->link_stats);
+	if (ret < 0)
+		goto err_free_vpn_stats;
+
 	INIT_WORK(&peer->keepalive_work, ovpn_peer_keepalive_send);
 
+	/* Initialize N-work pool for parallel decryption */
+	skb_queue_head_init(&peer->decrypt_queue);
+	for (i = 0; i < OVPN_MAX_PARALLEL; i++) {
+		INIT_WORK(&peer->decrypt_ctx[i].work, ovpn_decrypt_worker);
+		peer->decrypt_ctx[i].peer = peer;
+	}
+	atomic_set(&peer->next_decrypt_idx, 0);
+	atomic_set(&peer->tcp_next_deliver, 0);
+	atomic_set(&peer->tcp_next_assign, 0);
+
+	/* Initialize N-work pool for parallel encryption */
+	skb_queue_head_init(&peer->encrypt_queue);
+	for (i = 0; i < OVPN_MAX_PARALLEL; i++) {
+		INIT_WORK(&peer->encrypt_ctx[i].work, ovpn_encrypt_worker);
+		peer->encrypt_ctx[i].peer = peer;
+	}
+	atomic_set(&peer->next_encrypt_idx, 0);
+
 	ret = dst_cache_init(&peer->dst_cache, GFP_KERNEL);
 	if (ret < 0) {
 		netdev_err(ovpn->dev,
 			   "cannot initialize dst cache for peer %u\n",
 			   peer->id);
-		kfree(peer);
-		return ERR_PTR(ret);
+		goto err_free_link_stats;
 	}
 
 	netdev_hold(ovpn->dev, &peer->dev_tracker, GFP_KERNEL);
 
 	return peer;
+
+err_free_link_stats:
+	ovpn_peer_stats_free(&peer->link_stats);
+err_free_vpn_stats:
+	ovpn_peer_stats_free(&peer->vpn_stats);
+err_free:
+	kfree(peer);
+	return ERR_PTR(ret);
 }
 
 /**
@@ -356,6 +389,27 @@ static void ovpn_peer_release_rcu(struct rcu_head *head)
  */
 void ovpn_peer_release(struct ovpn_peer *peer)
 {
+	struct sk_buff *skb;
+	int i;
+
+	/* Wait for any in-flight decrypt workers to complete */
+	for (i = 0; i < OVPN_MAX_PARALLEL; i++)
+		cancel_work_sync(&peer->decrypt_ctx[i].work);
+
+	/* Free any remaining skbs in the decrypt queue */
+	while ((skb = skb_dequeue(&peer->decrypt_queue)))
+		kfree_skb(skb);
+
+	/* Wait for any in-flight encrypt workers to complete */
+	for (i = 0; i < OVPN_MAX_PARALLEL; i++)
+		cancel_work_sync(&peer->encrypt_ctx[i].work);
+
+	/* Free any remaining skbs in the encrypt queue */
+	while ((skb = skb_dequeue(&peer->encrypt_queue)))
+		kfree_skb(skb);
+
+	ovpn_peer_stats_free(&peer->vpn_stats);
+	ovpn_peer_stats_free(&peer->link_stats);
 	ovpn_crypto_state_release(&peer->crypto);
 	spin_lock_bh(&peer->lock);
 	ovpn_bind_reset(peer, NULL);
