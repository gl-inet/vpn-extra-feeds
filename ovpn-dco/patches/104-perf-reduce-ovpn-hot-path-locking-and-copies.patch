+static bool ovpn_udp_endpoint_update_needed(struct ovpn_peer *peer,
+					    struct sk_buff *skb)
+{
+	struct in6_addr local6;
+	struct ovpn_bind *bind;
+
+	bind = rcu_dereference(peer->bind);
+	if (unlikely(!bind))
+		return false;
+
+	if (unlikely(!ovpn_bind_skb_src_match(bind, skb)))
+		return true;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		return unlikely(READ_ONCE(bind->local.ipv4.s_addr) !=
+				ip_hdr(skb)->daddr);
+	case htons(ETH_P_IPV6):
+		local6 = READ_ONCE(bind->local.ipv6);
+		return unlikely(!ipv6_addr_equal(&local6,
+						 &ipv6_hdr(skb)->daddr));
+	default:
+		return false;
+	}
+}
